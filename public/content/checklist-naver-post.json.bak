link-thumbnail-resource\" alt=\"\" />\n                                </a>\n                                <a href=\"https://blog.naver.com/umnagumo/223798627548\" class=\"se-oglink-info __se_link\" target=\"_blank\" data-linktype=\"oglink\" data-linkdata='{\"id\": \"SE-5aec9952-2df8-453e-8d2f-309e07f0557b\", \"link\": \"https://blog.naver.com/umnagumo/223798627548\"}'>\n                                    <div class=\"se-oglink-info-container\">\n                                        <strong class=\"se-oglink-title\">[엄나구모성형외과 정보글]가슴 보형물, 어디에 위치하는 것이 가장 좋을까?</strong>\n                                        <p class=\"se-oglink-summary\">가슴 확대 수술에서 절개 부위를 결정했다면, 그다음으로 중요한 고민은 보형물을 어느 깊이에 삽입할 것인...</p>\n                                        <p class=\"se-oglink-url\">blog.naver.com</p>\n                                    </div>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>\n                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-b6666968-d64a-4fd4-a9f0-f604c98bdcd0\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-f2732bd8-c799-45cc-9d40-6a4b80b1912c\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-center \" style=\"\" id=\"SE-fff70aff-e2ee-4f5d-bfad-875ab85824ea\"><span style=\"\" class=\"se-fs- se-ff-nanummaruburi   \" id=\"SE-45ee64a2-dec2-422e-bee6-8cf1c94895b2\"><b>수술에 대하여</b></span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-default\" id=\"SE-ac34681e-1cea-472e-88c3-9168930f31d0\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-default se-section-align-center\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-a9d6c141-c223-4e5c-b617-7f0e3831843c\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-545435c2-ad9b-43a6-9b91-4141b8729c28\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-fe42576c-cb80-4ea9-a1fa-05b9698d4770\"><u><b>Q . 어떤 종류의 마취를 하나요?</b></u></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-38020581-c9fe-472a-9824-f43694f5b288\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-09b7a53d-35c3-41df-928e-dd0379493fda\">확대수술은 전신마취로 진행하고, 거상 혹은 흉터 제거술은 수면마취로 진행합니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-4f9848c7-d3b4-432f-a147-f99276e1ed8f\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-affd0211-962f-4bc9-bf82-5924b1cd5ab3\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-b1e22879-ab42-4b05-abb8-d0cc538fcf74\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-48cbf080-5fc0-495f-a50b-12ba9fc2f8ee\"><u><b>Q . 수술시간은 얼마나 걸립니까?</b></u></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-eb79deb8-6f00-41f7-a71a-405bd4c579f1\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-0e6af5c4-c397-437f-b2b1-a3fb0a264c09\">양쪽 보형물 삽입까지 약 50분 내외, 절개부 봉합까지 추가로 7~8분 소요됩니다. (수술 전후 소독 및 회복시간은 별도 소요됩니다.)</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-2ab1e2f4-69c1-496c-b158-7eb3e28453ec\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-f9b8c077-707d-4190-ada9-4f27b191cacb\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-1667759d-e639-4a5b-87a8-2f10c160667b\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-e87d54b7-c5f4-4ba5-b6c4-4c10d4ee22a3\"><u><b>Q . 비상사태 시 어떤 대응을 합니까?</b></u></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-bfbad948-54a0-4567-96d5-92db83e922e6\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-bd105c2a-aed8-4c2d-8ce7-049f897f9ca3\">비상사태는 거의 발생하지 않으나, 본원은 수술 중환자의 바이탈(혈압, 맥박, 호흡수, 체온, 산소 포화도)과 심전도 등을 자동으로 체크하는 최신 모니터 시스템을 갖추고 있으며, 만일의 사태에 대비해 마취과 전문의, 수술실 간호사가 모두 팀워크를 통해 신속하고 침착하게 대처할 수 있도록 체계적으로 훈련되어 있습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-d5f08840-d222-45f7-a6c8-4ec86650fb33\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-5601cd5b-9f05-428c-bcf9-fa17e724ce0d\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-4c3a7632-6e52-43cc-847c-62854827358f\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-181cae6d-b811-48e5-a89a-ed94ac313fd7\"><u><b>Q . 드레인(배액관)은 삽입합니까?</b></u></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-f46e1f1f-af2c-424c-93ed-e5308ee71e58\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-c9fb58f2-f0e1-4221-b5a0-146aff2f88c8\">출혈이 거의 없는 경우 드레인은 하지 않지만, 혈압 증가로 인한 지혈 부족이나 지혈이 잘 안되는 경우 등에는 필요 시 1~2일간 드레인을 설치하기도 합니다.</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-d61a0a39-b24e-4fef-aa57-e6e6e7d0d8fb\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-ead86146-909e-4eb2-9848-31794e8b17ff\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-center \" style=\"\" id=\"SE-2a48b40a-7255-4768-9432-ecd2c0064090\"><span style=\"\" class=\"se-fs- se-ff-nanummaruburi   \" id=\"SE-3b9aa9d2-e24f-409b-8291-940db37c6193\"><b>수술직후 통증에 대한 처치</b></span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-default\" id=\"SE-cab548b7-9016-4c72-b3e0-0afed079d3d8\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-default se-section-align-center\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-b8c3c864-c76a-465a-ad7c-8ed01992ddcc\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-a64db02d-2b53-4cdf-9e89-b3416c9360f3\"><span style=\"\" class=\"se-fs-fs11 se-ff-nanummaruburi   \" id=\"SE-71be4d6a-d33e-4145-b2a7-149a1dba01a5\"><b>​</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-20b16cc9-663f-4530-b513-1517a5200ead\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-7e87d581-37ca-4a23-9a85-14f85dbb8b3a\"><u><b>STEP 1</b></u></span><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-93d9d112-0c44-421f-9845-ca645e4bbe92\"><u> :</u></span><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-cbcf6fa5-48d8-4e9e-a342-33c1b290b05d\"> 해부학적으로 정확한 층을 박리하여 출혈과 손상을 최소화하여 통증 자체를 줄입니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-8d6e769e-34db-4605-90b7-0556f89199cb\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-5bd08968-d577-4d54-a871-2ec87c55cff3\"><u><b>STEP 2</b></u></span><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-1e41c71f-368f-4a7b-8df8-78d0daf06f42\"><u> :</u></span><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-eb0f2d89-f408-46aa-98b5-9707b2657f29\"> 무통 마취 키트를 적용해 통증을 지속적으로 관리합니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-57f5f99a-f7d8-4d48-bd7a-abde54be8d40\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-5b2d8998-952f-4742-96db-7a8e1eb11bd5\"><u><b>STEP 3</b></u></span><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-18a340ac-d939-4884-b29d-17a4d8c60ef0\"><u> :</u></span><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-d22c75ad-d411-4441-9bcc-e039d7983774\"> 출혈 감소 덕분에 수술 후 피통이나 밴드 압박을 하지 않아 훨씬 편안한 회복이 가능합니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-2f4a5238-ebc8-45e5-90a4-40a85fdd5a25\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-c5e1a3be-e21d-4624-8517-dad9f50b8cce\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-f0d44d10-53cc-4d46-a47b-09098d9d2b5f\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-098a7b73-b561-42cb-b21c-56a11b845256\"><b>수술 후 느끼는 불편함은 밴드 압박으로 인한 답답함이나 등 결림이 주로이며, 대부분 수술 후 1시간 정도 지나면 편안해집니다.</b></span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-d4a066f8-31b2-4ddd-85a2-37eb4c375301\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-fb09ba22-4328-44d4-8cc1-ed6db29083c6\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-20eb578f-1066-4ae2-ae7a-cf1934efa735\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-9a644af9-eb0d-41a3-a2e6-9783bf5cf88b\"><b>출혈이 매우 적은 이유</b></span></p><p class=\"se-text-paragraph se-text-paragraph-align-center \" style=\"\" id=\"SE-c948933b-b491-407e-9169-0f2e93d7caad\"><span style=\"\" class=\"se-fs- se-ff-nanummaruburi   \" id=\"SE-c133bce0-26aa-4343-b26a-5a02687b2def\"><b>​</b></span></p><ol class=\"se-text-list se-text-list-type-decimal\"><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-a57880fb-2101-4818-82e9-3a9df3b57f0d\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-b7bf4f5d-18cd-4838-9abf-37c5294aa000\">겨드랑이 부위 혈관을 직접 보며 지혈</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-997f6ee3-ef04-4005-abba-cc0d9def8333\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-5bf691e4-f096-4904-9b0f-528864edce3a\">가슴방 윗부분은 근막 사이로 박리해 출혈 거의 없음</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-13676031-0403-449c-ab06-3d6710550ee5\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-195184fe-3a29-496d-98a9-95e7c61d2852\">가슴방 아래는 내시경하 전기소작법으로 출혈 포인트를 정확히 지혈</span></p></li></ol><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-ef8b3535-0e64-4330-a139-d41b26ce7a3e\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-2c8c0fed-c89f-4a7d-95f8-a57ac1ffee7a\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b4bf5275-84d6-443d-aa1f-950e6fd41919\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-a46f4e33-36a6-4992-9560-730cf2f77e0c\"><b>수술 후 회복</b></span></p><p class=\"se-text-paragraph se-text-paragraph-align-center \" style=\"\" id=\"SE-475569df-7fd5-42d7-98f1-c055b1edf2bd\"><span style=\"\" class=\"se-fs- se-ff-nanummaruburi   \" id=\"SE-f6686966-04e0-492f-9eed-03812643eed1\"><b>​</b></span></p><ul class=\"se-text-list se-text-list-type-bullet-disc\"><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-51e46324-956d-49b4-aa75-38bdb6276677\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-df1ed6a5-0fa0-4996-b93b-19f1043d4727\">마취에서 깨어나는 시간: 수술 후 5~10분</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-0a738e71-0805-4db1-b59e-1401839c9bc1\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-3184aa30-5189-455e-8e7a-8004ca3fc130\">회복실 완비: 환자 상태 모니터링 가능</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7f7a5ffc-290f-45ec-bb4e-0fa5c31f75f2\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-1644d1c6-37fd-4c21-8bc4-ad22b1e4b1bc\">몸 상태가 좋지 않으면 수술 연기 가능</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-0c846c6f-3393-4023-ae79-af2e35aae80d\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-f6d9f27c-defb-4fd3-97af-36ae403fb0b8\">수술 후 병원 머무는 시간: 약 2~3시간</span></p></li></ul><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-b6265ca7-0459-4303-a61a-2c49f7d12a70\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-5c286051-1c97-4d31-b249-93c92c3d42b0\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a91217d0-c6d4-4bf7-8c5a-cac1fd0aad4f\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-d120228d-8ecf-4a79-9245-1f47046af872\"><b>수술 직후 상태</b></span></p><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d224362b-4498-44ff-b73e-4d01f3322307\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-d8b17386-9374-492d-90df-9653cac8e69f\"><b>​</b></span></p><ul class=\"se-text-list se-text-list-type-bullet-disc\"><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-d9e8ab52-f997-4938-9700-42c15792bd84\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-704b32d5-31aa-4bf1-ab53-d75ee74670c9\">멍, 통증, 붓기는 약간 있을 수 있음</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-dee12292-8fed-40fa-864f-e78853eb1734\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-559e055f-321d-4567-b60f-960d8aa677a6\">출혈은 드문 편</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-3a244c8b-f0d7-441e-8357-d9f75ec4f877\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-dd89d590-5238-42e6-bf51-10c304ef3146\">유두 감각: 일시적으로 둔하거나 예민할 수 있으나 대부분 6개월~2년 내 회복</span></p></li></ul><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-cb1cffb7-0f19-4188-bf37-3a139a433c05\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-803acdee-7ea6-477b-a74a-07ffecf43215\">​</span></p><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d119c893-3be8-418f-b2ae-92de1df2ff62\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-70698e78-b75d-491b-8aa7-416709ed2dc3\"><b>일상생활 복귀</b></span></p><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-d8bcf448-b8e8-4088-b518-d218599b9479\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-96d11af1-d3de-4de4-9353-28a8932a563d\">​</span></p><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-bdf6d87b-36ee-472a-8627-fda725e69898\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-4793fee1-5144-43ee-83c0-b3d25ea800b9\">근막하 또는 이중평면 방식에 따라 다르나 대개 3~5일이면 가능합니다.</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-bac8df26-6fd7-416f-b8a1-bcf95cd620f5\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-eac0d09b-965b-43f9-9c14-f2418734d7b7\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f7173986-deac-4942-bb1e-0e0d0c4160fe\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-2848878b-ba8a-4f89-a892-81b50e3e9d93\"><b>수술부위 장기 변화</b></span></p><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-be810ef4-afc8-4d50-af4e-82651505f942\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-31174a28-84cc-41f2-8d6a-ac0840a33ccd\"><b>​</b></span></p><ul class=\"se-text-list se-text-list-type-bullet-disc\"><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-955d4861-73e3-4453-9d64-8fc6d52d17f7\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-e7effd24-255b-459a-8363-1d0fa3400dd6\">보형물 외피가 만져지거나 주름질 수 있음(피부 얇거나 지방 적을 경우)</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-50f63c15-3e0f-4187-9bff-f74a46829ddb\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-18e6ccf8-100e-4cbb-ad9c-8b3029aa05d7\">파손 여부 확인: 초음파 검사, MRI 검사</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-82561733-278a-4b36-a974-8fc9e269a2c2\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-33e8dcf4-bcf5-48df-ab95-499f2235585b\">파손시 별다른 증상 없으나 제거 또는 교체 필요</span></p></li></ul><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-b1aeb7d5-e3f7-49e4-8c43-75e1867af082\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-d0ef9101-f47a-478f-b117-4b65a13aaa6c\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-71436ca1-1000-4c36-b492-bc317ea8d9d3\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-fdec0182-e663-430c-8454-bfed6db70324\"><b>피막구축(구형구축)</b></span></p><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-70cad890-bc4e-49f2-8280-9753f2ce4f32\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-edd3346d-a7a0-4639-a690-11239363be0a\"><b>​</b></span></p><ul class=\"se-text-list se-text-list-type-bullet-disc\"><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-71da1353-05ab-4b03-9ac3-152f8cd0e095\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-fdbdedbd-f861-41d2-90db-6101e03d1711\">발생 원인: 출혈, 삼출액, 감염, 이물질 등</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-aa89c46a-f9d8-49bf-b462-2daedb672c89\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-23e78986-44d2-4f7f-9aa9-7366881f4341\">본원 발생률: 1% 미만</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-2b81295e-7589-4944-8871-6b5718f18d71\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-c04a1b91-e1b7-4302-86ac-a706c837d75d\">심한 경우 통증 동반</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-7229c3f2-7f23-40b0-925e-3c0e17318cdc\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-a16c0fcf-5799-423d-b86a-d54cc8ee556c\">피막구축 발생 시 재수술 필요 가능성 있음</span></p></li></ul><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-262c425d-693e-4505-bd46-f7e08eb4220c\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-79bec53a-4ef5-4717-9feb-c04179d221b1\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-bdb88d7a-3406-4d84-957d-2adc5c92df72\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-29daf5b5-7a8b-4c3e-be46-ca0a4d9aab76\"><b>수술 후 검진</b></span></p><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-eb42ca96-0ef2-45b0-af83-5590bae8940a\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-3dfd0d22-39c0-4912-a23d-0022a34b1de3\"><b>​</b></span></p><ul class=\"se-text-list se-text-list-type-bullet-disc\"><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-0a650c7c-26b1-4ce8-b949-661eb7c52a2c\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-507c7442-71bf-4053-97db-8e190f39057b\">검진 일정: 수술 다음날 → 7일째 → 3주째 → 이후 연 1회</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-31bde3ff-b718-418c-8419-2dcf5a10511a\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-4e60ddcb-72f2-4e8d-aa3d-ef10c42654a4\">걱정되는 증상 있을 시 언제든 검진 가능</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-74a629a3-d6d7-45c6-aa62-522ec9dafb47\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-6d79411a-2368-404b-917a-46d0e830f6f3\">파손 확인: 초음파, 필요시 MRI</span></p></li></ul><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-66231cd8-48cb-4cf3-93fd-07cc2313e3d4\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-89444f70-7229-4869-9760-44b99917bc59\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-87be745f-4df7-4ffd-b4df-17a2a9de103c\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi  se-style-unset \" id=\"SE-13c51122-073e-4ef0-bbb3-c3401ceec783\"><b>보형물 관련 검사 및 수유</b></span></p><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-f909650f-8ef0-4965-82b0-643192824dec\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi  se-style-unset \" id=\"SE-5952ba0a-154b-45a4-a1c3-59944b98edd6\"><b>​</b></span></p><ul class=\"se-text-list se-text-list-type-bullet-disc\"><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-2bfb8ddf-8695-4a5e-8a96-e680ac9250c6\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-d73ff97a-3be3-48c4-9155-d02824652657\">초음파, 맘모그라피, MRI 모두 가능</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-6c258a40-13a5-46be-b193-a1dd28698a95\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-8823323c-63a4-432b-8236-c147be7f68fd\">보형물이 유방암 검진에 장애가 되지 않음</span></p></li><li class=\"se-text-list-item\" ><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-948ee8d1-9ec2-47fe-b0bf-9514578cd331\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-77d46416-9818-4631-bc75-27d5787b94bc\">수유 및 아기에게도 영향 없음</span></p></li></ul><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-horizontalLine se-l-line1\" id=\"SE-bacf3fab-7aef-4d6b-9628-d58ec7513717\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-horizontalLine se-l-line1 se-section-align-justify\">\n                            <div class=\"se-module se-module-horizontalLine\">\n                                <hr class=\"se-hr\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-text se-l-default\" id=\"SE-0de3a331-80b1-46a6-ba2f-af357b4978fd\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-2505aac6-8632-422d-a6da-185eb0f510fb\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-abeba36f-ee23-47c3-bce8-b5ce936d864e\"><b>문제가 발생할 경우</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-90abc5ba-0e0b-4f77-bc0e-f5fa86f3fe48\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-0eef8eb2-f154-41d3-9117-dcafc40211c2\"><b>​</b></span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align-justify \" style=\"\" id=\"SE-e13c750b-96a3-42d0-8ced-8c34ef63a4bd\"><span style=\"\" class=\"se-fs-fs13 se-ff-nanummaruburi   \" id=\"SE-f5cf05a1-2335-4942-abfe-e11674371dcd\">정기적인 내원과 본원의 지시에 잘 따라주시면 대부분 문제없이 좋은 결과를 얻을 수 있습니다. 모양 변형이나 보형물 파손이 없다면 재수술은 필요 없으며, 재수술은 약 3% 정도의 확률로 시행됩니다.</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                    \n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-6c5e3c04-570c-46dc-9544-5dc363371b79\">\n                    <div class=\"se-component-content se-component-content-extend\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-justify\" >\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-imag